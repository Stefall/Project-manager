{
    "name": "vlt/project-manager-api",
    "description": "API REST de VLT Project Manager (Google Sheets comme base de données)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "google/apiclient": "^2.15",
        "dompdf/dompdf": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "Vlt\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Vlt\\Tests\\": "tests/" }
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "test": "phpunit tests"
    },
    "extra": {
        "google/apiclient-services": ["Sheets"]
    },
    "config": { "sort-packages": true }
}
