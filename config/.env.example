# Copier en config/.env (hors de la racine web) et remplir.

APP_ENV=production            # production | development
APP_URL=https://pm.example.fr
APP_TIMEZONE=Europe/Paris

# Stockage : "google" en production, "local" pour développer sans Google
STORAGE_DRIVER=google
GOOGLE_SPREADSHEET_ID=
# Chemin absolu de la clé JSON du compte de service (jamais dans public/)
GOOGLE_SERVICE_ACCOUNT_FILE=/chemin/vers/config/service-account.json
# Fichier utilisé par le driver "local"
LOCAL_STORE_FILE=storage/data/local-sheet.json

# Durée de cache des lectures Sheets, en secondes
SHEETS_CACHE_TTL=5

# Sessions
SESSION_IDLE_MINUTES=480
SESSION_NAME=vltpm

# Sauvegardes
BACKUP_DIR=storage/backups
BACKUP_KEEP_DAYS=30
